---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apps } from "../data/apps";
import { plugins } from "../data/plugins";

const featuredApps = apps.slice(0, 3);
const featuredPlugins = plugins.slice(0, 3);
---

<BaseLayout title="wonkoworld">
  <p class="eyebrow">wonkoworld</p>
  <h1>Plugins and apps I build.</h1>
  <p class="lede">
    A home for the WordPress plugins and applications I make, starting with
    PrintMonitor.
  </p>

  <div class="section-title">
    <h2>Apps</h2>
    <a href="/apps">View all &rarr;</a>
  </div>
  <div class="card-grid">
    {
      featuredApps.map((app) => (
        <a class="card" href={`/apps/${app.slug}`}>
          <h3>{app.name}</h3>
          <p>{app.tagline}</p>
        </a>
      ))
    }
  </div>

  <div class="section-title">
    <h2>WordPress plugins</h2>
    <a href="/plugins">View all &rarr;</a>
  </div>
  {
    featuredPlugins.length > 0 ? (
      <div class="card-grid">
        {featuredPlugins.map((plugin) => (
          <a class="card" href={`/plugins/${plugin.slug}`}>
            <h3>{plugin.name}</h3>
            <p>{plugin.tagline}</p>
          </a>
        ))}
      </div>
    ) : (
      <p class="placeholder">No plugins published yet — check back soon.</p>
    )
  }
</BaseLayout>
