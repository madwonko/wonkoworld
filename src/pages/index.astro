---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apps } from "../data/apps";
import { plugins } from "../data/plugins";

const featuredApps = apps.slice(0, 3);
const featuredPlugins = plugins.slice(0, 3);
---

<BaseLayout title="wonkoworld">
  <div class="terminal">
    <div class="term-bar">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
      <span class="term-title">wonkoworld — zsh — 80x24</span>
    </div>
    <div class="term-body">
      <p class="term-line"><span class="prompt">$</span> whoami</p>
      <p class="term-output headline">
        wonkoworld
        <span class="lede">Plugins and apps I build, starting with PrintMonitor.</span>
      </p>
      <p class="term-line"><span class="prompt">$</span> ls</p>
      <p class="term-output">apps/&nbsp;&nbsp;plugins/</p>
      <p class="term-line"><span class="prompt">$</span> <span class="cursor">&nbsp;</span></p>
    </div>
  </div>

  <div class="section-title">
    <h2><span class="highlight">Apps</span></h2>
    <a href="/apps">ls -la /apps &rarr;</a>
  </div>
  <div class="card-grid">
    {
      featuredApps.map((app) => (
        <a class="card" href={`/apps/${app.slug}`}>
          <span class="path">~/apps/{app.slug}</span>
          <h3>{app.name}</h3>
          <p>{app.tagline}</p>
        </a>
      ))
    }
  </div>

  <div class="section-title">
    <h2><span class="highlight">WordPress plugins</span></h2>
    <a href="/plugins">ls -la /plugins &rarr;</a>
  </div>
  {
    featuredPlugins.length > 0 ? (
      <div class="card-grid">
        {featuredPlugins.map((plugin) => (
          <a class="card" href={`/plugins/${plugin.slug}`}>
            <span class="path">~/plugins/{plugin.slug}</span>
            <h3>{plugin.name}</h3>
            <p>{plugin.tagline}</p>
          </a>
        ))}
      </div>
    ) : (
      <p class="placeholder">No plugins published yet — check back soon.</p>
    )
  }
</BaseLayout>
