---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apps } from "../../data/apps";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
---

<BaseLayout title={`${app.name} — wonkoworld`} description={app.tagline}>
  <a class="back-link" href="/apps">apps</a>
  <div class="detail-header">
    <h1>{app.name}</h1>
    <span class="badge" data-status={app.status}>{app.status}</span>
  </div>
  <p class="lede">{app.tagline}</p>
  <p>{app.description}</p>

  {
    app.tags.length > 0 && (
      <div class="tag-row">
        {app.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }

  {
    app.links && app.links.length > 0 && (
      <div class="detail-meta">
        {app.links.map((link) => (
          <a class="btn" href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
